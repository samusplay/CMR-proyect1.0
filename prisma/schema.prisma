datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SystemType {
  MONOFASICO
  BIFASICO
  TRIFASICO
}

enum AnchorType {
  CHAZOS
  TORNILLOS
  UNISTRUT
}

enum InspectionStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ChargerMountType {
  ADOSADO_A_MURO
  PEDESTAL
}

enum InstallationType {
  SOLAR
  CARGADOR
  AMBOS
}

enum DealStage {
  NUEVO
  CONTACTADO
  CALIFICADO
  PROPUESTA
  GANADO
  PERDIDO
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("vendedor")
  deals     Deal[]
  createdAt DateTime @default(now())
}

model Campaign {
  id        String   @id @default(uuid())
  name      String
  channel   String
  utmSource String?
  active    Boolean  @default(true)
  leads     Lead[]
  createdAt DateTime @default(now())
}

model Lead {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  deal       Deal?
  createdAt  DateTime  @default(now())
}

model Deal {
  id                String            @id @default(uuid())
  stage             DealStage         @default(NUEVO)
  installationType  InstallationType
  estimatedValue    Int               // valor estimado de la instalación, en pesos
  expectedCloseDate DateTime?         // para saber cuándo se espera cerrar
  notes             String?           // notas del vendedor durante la negociación
  assignedTo        User?             @relation(fields: [assignedToId], references: [id])
  assignedToId      String?
  lead              Lead              @relation(fields: [leadId], references: [id])
  leadId            String            @unique
  client            Client?
  inspection        Inspection?
  updatedAt         DateTime          @updatedAt
}

model Client {
  id               String      @id @default(uuid())
  name             String
  email            String
  phone            String?
  address          String?
  installationDate DateTime?
  deal             Deal        @relation(fields: [dealId], references: [id])
  dealId           String      @unique
  createdAt        DateTime    @default(now())
}

model Inspection {
  id     String @id @default(uuid())
  deal   Deal   @relation(fields: [dealId], references: [id])
  dealId String @unique

  // 1. Información general
  inspectorName  String
  inspectionDate DateTime @default(now())
  location       String?
  parkingNumber  String?

  // 2. Red eléctrica existente
  systemType           SystemType
  systemDetail         String? // ej: "3Ø 208/120V"
  originPoint          String
  panelIdentification  String?
  breakerCapacity      String?
  hasPanelSpace        Boolean
  availablePanelSpaces String?
  requiresDrilling     Boolean
  drillingLocation     String?

  // 3. Trayectoria y canalización
  conduitType      String?
  conduitCondition String?
  conduitLength    Float?
  cableLength      Float?
  cableGauge       String?

  // 4. Instalación física y anclajes
  mountSurface     String?
  wallCondition    String?
  anchorType       AnchorType?
  requiredHardware String?
  chargerMountType ChargerMountType?
  chargerModel     String?

  // 5. Seguridad
  differentialProtectionRequired Boolean
  differentialType                String?
  groundResistanceOhms            Float?
  neutralGroundReading            String?
  measuredVoltage                 Float?
  lightingCondition               String?

  // 6-7. Observaciones y aprobación
  observations String?
  status       InspectionStatus @default(PENDIENTE)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}