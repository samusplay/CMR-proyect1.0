datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SystemType {
  MONOFASICO
  BIFASICO
  TRIFASICO
}

enum AnchorType {
  CHAZOS
  TORNILLOS
  UNISTRUT
}

enum InspectionStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ChargerMountType {
  ADOSADO_A_MURO
  PEDESTAL
}

enum InstallationType {
  SOLAR
  CARGADOR
  AMBOS
}

enum DealStage {
  NUEVO
  CONTACTADO
  CALIFICADO
  PROPUESTA
  GANADO
  PERDIDO
}

enum OfferStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

enum AppointmentStatus {
  PROGRAMADA
  REPROGRAMADA
  COMPLETADA
  CANCELADA
}

enum MaterialCategory {
  CABLEADO
  CANALIZACION
  PROTECCIONES
  CARGADOR
  ANCLAJES
  SOLAR
  MANO_DE_OBRA
  OTROS
}

model User {
  id                      String                  @id @default(uuid())
  name                    String
  email                   String                  @unique
  password                String
  role                    String                  @default("vendedor")
  deals                   Deal[]
  appointmentsAsInspector InspectionAppointment[] @relation("AppointmentInspector")
  appointmentsScheduled   InspectionAppointment[] @relation("AppointmentScheduler")
  appointmentsClosed      InspectionAppointment[] @relation("AppointmentCloser")
  createdAt               DateTime                @default(now())
}

model Campaign {
  id        String   @id @default(uuid())
  name      String
  channel   String
  utmSource String?
  active    Boolean  @default(true)
  leads     Lead[]
  createdAt DateTime @default(now())
}

model Lead {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  deal       Deal?
  createdAt  DateTime  @default(now())
}

model Deal {
  id                String                  @id @default(uuid())
  stage             DealStage               @default(NUEVO)
  installationType  InstallationType
  estimatedValue    Int                     // valor estimado de la instalación, en pesos
  expectedCloseDate DateTime?               // para saber cuándo se espera cerrar
  notes             String?                 // notas del vendedor durante la negociación
  assignedTo        User?                   @relation(fields: [assignedToId], references: [id])
  assignedToId      String?
  lead              Lead                    @relation(fields: [leadId], references: [id])
  leadId            String                  @unique
  client            Client?
  inspection        Inspection?
  offer             Offer?
  appointments      InspectionAppointment[]
  updatedAt         DateTime                @updatedAt
}

model Client {
  id               String      @id @default(uuid())
  name             String
  email            String
  phone            String?
  address          String?
  installationDate DateTime?
  deal             Deal        @relation(fields: [dealId], references: [id])
  dealId           String      @unique
  createdAt        DateTime    @default(now())
}

model Inspection {
  id     String @id @default(uuid())
  deal   Deal   @relation(fields: [dealId], references: [id])
  dealId String @unique

  // 1. Información general
  inspectorName  String
  inspectionDate DateTime @default(now())
  location       String?
  parkingNumber  String?

  // 2. Red eléctrica existente
  systemType           SystemType
  systemDetail         String? // ej: "3Ø 208/120V"
  originPoint          String
  panelIdentification  String?
  breakerCapacity      String?
  hasPanelSpace        Boolean
  availablePanelSpaces String?
  requiresDrilling     Boolean
  drillingLocation     String?

  // 3. Trayectoria y canalización
  conduitType      String?
  conduitCondition String?
  conduitLength    Float?
  cableLength      Float?
  cableGauge       String?

  // 4. Instalación física y anclajes
  mountSurface     String?
  wallCondition    String?
  anchorType       AnchorType?
  requiredHardware String?
  chargerMountType ChargerMountType?
  chargerModel     String?

  // 5. Seguridad
  differentialProtectionRequired Boolean
  differentialType                String?
  groundResistanceOhms            Float?
  neutralGroundReading            String?
  measuredVoltage                 Float?
  lightingCondition               String?

  // 6-7. Observaciones y aprobación
  observations String?
  status       InspectionStatus @default(PENDIENTE)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id          String           @id @default(uuid())
  code        String           @unique
  description String
  category    MaterialCategory
  unitCode    String           // UN, ML, etc.
  unitPrice   Int              // pesos COP
  active      Boolean          @default(true)
  offerItems  OfferItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
}

model Offer {
  id                String      @id @default(uuid())
  deal              Deal        @relation(fields: [dealId], references: [id])
  dealId            String      @unique
  offerNumber       String      @unique
  title             String
  aiuPercentage     Float       @default(0.15)
  ivaPercentage     Float       @default(0.19)
  deliveryTime      String?
  deliveryCondition String?
  warranty          String?
  paymentTerms      String?
  validityDays      Int         @default(30)
  status            OfferStatus @default(BORRADOR)
  pdfUrl            String?
  items             OfferItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OfferItem {
  id          String    @id @default(uuid())
  offer       Offer     @relation(fields: [offerId], references: [id])
  offerId     String
  material    Material? @relation(fields: [materialId], references: [id])
  materialId  String?
  lineNumber  Int
  unitCode    String?
  description String
  quantity    Float
  unitPrice   Int
  groupLabel  String?
}

model InspectionAppointment {
  id            String            @id @default(uuid())
  deal          Deal              @relation(fields: [dealId], references: [id])
  dealId        String
  scheduledAt   DateTime          // se guarda en UTC; la app lo muestra en hora de Bogotá
  status        AppointmentStatus @default(PROGRAMADA)
  inspector     User?             @relation("AppointmentInspector", fields: [inspectorId], references: [id])
  inspectorId   String?
  scheduledBy   User              @relation("AppointmentScheduler", fields: [scheduledById], references: [id])
  scheduledById String
  closedBy      User?             @relation("AppointmentCloser", fields: [closedById], references: [id])
  closedById    String?           // quién la reprogramó o canceló
  closedAt      DateTime?
  notes         String?
  reason        String?           // motivo de cancelación o reprogramación
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([dealId])
  @@index([inspectorId, scheduledAt])
  @@index([scheduledAt])
}